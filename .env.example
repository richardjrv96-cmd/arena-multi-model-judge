# ── Arena environment ─────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your key. `.env.local` is gitignored.
#
# Get a key at https://openrouter.ai/keys
# This single key powers BOTH free (:free) and premium models.
OPENROUTER_API_KEY=

# Optional: used only for OpenRouter's attribution headers (HTTP-Referer / X-Title).
# On Vercel you can set this to your deployment URL. Safe to leave blank locally.
# OPENROUTER_SITE_URL=https://your-app.vercel.app
